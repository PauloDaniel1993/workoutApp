generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  trainer
  admin
}

enum WorkoutChangeReason {
  change_exercises
  change_schedule
  increase_difficulty
  decrease_difficulty
  other
}

enum RequestStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         UserRole
  passwordHash String
  createdAt    DateTime @default(now())

  trainerAssignments TrainerAssignment[] @relation("Trainer")
  userAssignments    TrainerAssignment[] @relation("AssignedUser")
  workouts           Workout[]
  requests           WorkoutChangeRequest[]
}

model TrainerAssignment {
  trainerId String
  userId    String

  trainer User @relation("Trainer", fields: [trainerId], references: [id])
  user    User @relation("AssignedUser", fields: [userId], references: [id])

  @@id([trainerId, userId])
  @@index([trainerId])
  @@index([userId])
}

model Workout {
  id     String @id @default(uuid())
  userId String
  date   String
  name   String

  user      User       @relation(fields: [userId], references: [id])
  exercises Exercise[]

  @@index([userId])
}

model Exercise {
  id         String  @id @default(uuid())
  workoutId  String
  name       String
  sets       Int
  reps       Int
  weight     Int
  youtubeUrl String
  completed  Boolean @default(false)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model WorkoutChangeRequest {
  id        String              @id @default(uuid())
  userId    String
  reason    WorkoutChangeReason
  message   String
  status    RequestStatus       @default(pending)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
